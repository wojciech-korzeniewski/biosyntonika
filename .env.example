# Publiczny adres strony (bez ukośnika na końcu)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Trener IKIGAI (opcjonalne – bez tych kluczy działa tryb bez AI i zgłoszenie „do skopiowania”) ---

# Claude API (https://platform.claude.com) – komentarze trenera, pytania pogłębiające, finał
ANTHROPIC_API_KEY=
# Domyślnie claude-opus-5-5
IKIGAI_MODEL=

# Wysyłka zgłoszeń na sesję e-mailem przez Resend (https://resend.com, darmowy plan)
RESEND_API_KEY=
# Nadawca z domeny zweryfikowanej w Resend, np. "Trener IKIGAI <ikigai@biosyntonika.com.pl>"
IKIGAI_MAIL_FROM=
# Odbiorca zgłoszeń (domyślnie e-mail z danych kontaktowych strony)
IKIGAI_COACH_EMAIL=
